{
  "ReverseProxy": {
    "Routes": {
      "users": {
        "ClusterId": "accounts-api",
        "Order": 10,
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "donations": {
        "ClusterId": "accounts-api",
        "Order": 10,
        "Match": { "Path": "/api/donations/{**catch-all}" }
      },
      "user-achievements": {
        "ClusterId": "accounts-api",
        "Order": 10,
        "Match": { "Path": "/api/user-achievements/{**catch-all}" }
      },
      "newsletters": {
        "ClusterId": "newsletters-api",
        "Order": 10,
        "Match": { "Path": "/api/newsletters/{**catch-all}" }
      },
      "subscriptions": {
        "ClusterId": "newsletters-api",
        "Order": 10,
        "Match": { "Path": "/api/subscriptions/{**catch-all}" }
      },
      "users-copy": {
        "ClusterId": "newsletters-api",
        "Order": 10,
        "Match": { "Path": "/api/users-copy/{**catch-all}" }
      },
      "statistics": {
        "ClusterId": "gamestats-api",
        "Order": 10,
        "Match": { "Path": "/api/stats/{**catch-all}" }
      },
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 0,
        "Match": { "Path": "/api/aggregator/{**catch-all}" }
      }
    },
    "Clusters": {
      "accounts-api": {
        "Destinations": { "default": { "Address": "https+http://accounts-api" } }
      },
      "newsletters-api": {
        "Destinations": { "default": { "Address": "https+http://newsletters-api" } }
      },
      "gamestats-api": {
        "Destinations": { "default": { "Address": "https+http://gamestats-api" } }
      },
      "aggregator": {
        "Destinations": { "default": { "Address": "https+http://aggregator" } }
      }
    }
  }
}
